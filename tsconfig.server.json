{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "server",
    "outDir": "dist-server",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["server"]
}
